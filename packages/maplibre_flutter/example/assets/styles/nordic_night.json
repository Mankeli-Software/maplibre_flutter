{
  "version": 8,
  "name": "Nordic Night (bundled asset)",
  "metadata": {
    "maplibre_flutter:note": "Loaded from the app bundle via style: 'asset://assets/styles/nordic_night.json'. Deliberately has no glyphs and no label layers, so it renders with no font endpoint and provokes no glyph 404 — the point here is where the DOCUMENT came from, not what it draws."
  },
  "sources": {
    "maplibre": {
      "type": "vector",
      "url": "https://demotiles.maplibre.org/tiles/tiles.json"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#0b1026" }
    },
    {
      "id": "countries-fill",
      "type": "fill",
      "source": "maplibre",
      "source-layer": "countries",
      "paint": { "fill-color": "#1c2b57", "fill-opacity": 0.9 }
    },
    {
      "id": "countries-boundary",
      "type": "line",
      "source": "maplibre",
      "source-layer": "countries",
      "paint": { "line-color": "#5f7fd4", "line-width": 0.8 }
    },
    {
      "id": "geolines",
      "type": "line",
      "source": "maplibre",
      "source-layer": "geolines",
      "paint": {
        "line-color": "#f2b134",
        "line-width": 0.7,
        "line-dasharray": [3, 3]
      }
    }
  ]
}
