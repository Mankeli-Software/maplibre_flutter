+// Compiles [urlTemplate] to a regex in which each recognised token is a capture
+// group and every other character is a literal. The token names are appended to
+// [tokens] in the order their groups appear, so group N+1 holds tokens[N].
+std::string urlTemplateToPattern(const std::string& urlTemplate, std::vector<std::string>* tokens) {
+    std::string pattern;
+    std::size_t pos = 0;
+    while (pos < urlTemplate.size()) {
+        std::size_t next = std::string::npos;
+        const char* found = nullptr;
+        for (const char* const token : urlTemplateTokens) {
+            const std::size_t at = urlTemplate.find(token, pos);
+            if (at < next) {
+                next = at;
+                found = token;
             }
         }
+        if (found == nullptr) break;
+        pattern += escapeRegexLiteral(urlTemplate.substr(pos, next - pos));
+        pattern += "(.+)";
+        if (tokens != nullptr) {
